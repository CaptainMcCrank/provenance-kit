# provenance-kit environment configuration
# Copy this file to `.env` in your project root and fill in the values.
# Never commit a real .env — add it to your .gitignore.

# =============================================================================
# Required
# =============================================================================

# Path to the prompt library whose files provenance-kit hashes for each build.
# This can be ANY version-controlled directory — a sibling checkout, a vendored
# copy, or (recommended) a gitignored symlink to a private library. The tool
# only reads it (to hash files and read its git commit); it is never bundled.
#
# Example (a gitignored symlink to your library):  ln -s ~/path/to/library ./prompts
PROMPT_LIBRARY_PATH=./prompts

# GPG key ID used to sign build attestations. If a build requires attestation
# and no signing key is configured, the build fails loudly at launch.
#   find a key:     gpg --list-secret-keys --keyid-format LONG
#   generate a key: gpg --full-generate-key
#
# Example: ABCD1234EFGH5678
GPG_SIGNING_KEY_ID=YOUR_GPG_KEY_ID_HERE

# =============================================================================
# Optional
# =============================================================================

# Override the GPG home directory (rarely needed).
# GNUPGHOME=~/.gnupg
